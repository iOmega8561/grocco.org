{
  "name": "grocco-site",
  "private": true,
  "license": "MPL-2.0",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "node scripts/sync-github.mjs",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "node scripts/sync-github.mjs && tsc -p tsconfig.json --noEmit && vite build",
    "build:offline": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node build/server/node/main.js"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
