# ~/.config/containers/systemd/status-web.container
[Unit]
Description=Serves the status document to the tunnel
After=status-agent.timer

[Container]
Image=docker.io/library/caddy:2-alpine
AutoUpdate=registry
ContainerName=status-web
Network=status.network
# No PublishPort: only cloudflared, on the same network, can reach it.

Volume=%h/.local/share/status:/srv:ro,Z
Volume=%h/.config/status-web/Caddyfile:/etc/caddy/Caddyfile:ro,Z
Environment=SITE_ORIGIN=https://grocco.org

ReadOnly=true
Tmpfs=/data
Tmpfs=/config
DropCapability=ALL
NoNewPrivileges=true

HealthCmd=wget -q -O /dev/null http://127.0.0.1:8080/status.json
HealthInterval=60s

[Service]
Restart=on-failure
MemoryMax=64M

[Install]
WantedBy=default.target
