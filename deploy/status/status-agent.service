# ~/.config/systemd/user/status-agent.service
[Unit]
Description=Send the server status report to the website

[Service]
Type=oneshot
Environment=STATUS_ENDPOINT=https://grocco.org/api/status
# Space-separated: the only containers whose state is reported.
Environment=STATUS_CONTAINERS=traefik retroshelf
# The token never sits in an environment variable: systemd hands the file to the service.
LoadCredential=status-token:%h/.config/status-agent/token
ExecStart=%h/.local/bin/status-agent.sh
NoNewPrivileges=true
PrivateTmp=true
