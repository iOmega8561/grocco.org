{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://status.grocco.org; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	# Every route belongs to the single-page app.
	try_files {path} /index.html
	file_server
}
